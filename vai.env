# ──────────────────────────────────────────────────────────
# Vertex AI Model Registration — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# ── Auth (required) ────────────────────────────────────────
# GCP access token: gcloud auth print-access-token
CLOUD_TOKEN=

# ── Required ───────────────────────────────────────────────
PROJECT=my-gcp-project
LOCATION=us-central1
DISPLAY_NAME=my-model
ARTIFACT_URI=gs://my-bucket/model/
CONTAINER_IMAGE=us-docker.pkg.dev/vertex-ai/prediction/sklearn-cpu.1-3:latest

# ── Optional metadata ──────────────────────────────────────
DESCRIPTION=
VERSION_DESCRIPTION=
# Only used when registering a brand-new model (not a new version)
MODEL_ID=

# Labels: comma-separated KEY=VALUE pairs
# LABELS=env=prod,team=ml
LABELS=

# ── Container options ──────────────────────────────────────
PREDICT_ROUTE=/predict
HEALTH_ROUTE=/ping

# Comma-separated port numbers
# CONTAINER_PORTS=8080
CONTAINER_PORTS=

# Container environment variables: comma-separated KEY=VALUE pairs
# CONTAINER_ENV_VARS=AIP_HTTP_PORT=8080,MODEL_ENV=production
CONTAINER_ENV_VARS=

# ── Behaviour flags ────────────────────────────────────────
# Set to true to print the SDK payload without calling the API
DRY_RUN=false

# Set to true to return immediately without waiting for the LRO to complete
NO_WAIT=false
